      "fix": "Un emoji como máximo, y que no sea uno de estos cinco."
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:#\\w+[ \\t]*){5,}",
      "name": "Muro de hashtags (5 o más)",
      "fix": "Tres hashtags. LinkedIn dejó de premiar el muro."
    },
    {
      "id": "as-an-ai",
      "regex": "(?i)\\bas an ai\\b|\\bas a language model\\b",
      "name": "El modelo hablando de sí mismo (inglés)",
      "fix": "Borra la oración."
    },
    {
      "id": "in-summary",
      "regex": "(?i)^\\s*(?:in summary|to summarize|in conclusion)\\b",
      "name": "Cierre de ensayo al inicio de línea (inglés)",
      "fix": "Una publicación no necesita un párrafo de conclusión."
    },
    {
      "id": "engagement-bait",
      "regex": "(?i)\\b(?:agree\\?|thoughts\\?|who else\\b|am i wrong\\?)\\s*$",
      "name": "Cebo de interacción por reflejo (inglés)",
      "fix": "Haz una pregunta que solo tú podrías hacer, sobre lo concreto que dijiste arriba."
    },
    {
      "id": "stop-scroll",
      "regex": "(?im)^\\s*(?:stop scrolling|don'?t scroll|wait[,.]? don'?t scroll)\\b",
      "name": "Apertura «stop scrolling» (inglés)",
