  "structures": [
    {
      "id": "not-just",
      "regex": "(?i)\\bit'?s not (?:just|only) [^.!?\\n]{2,60}[,.] it'?s\\b",
      "name": "«It's not just X, it's Y» (inglés)",
      "fix": "Di lo único que de verdad quieres decir. Borra la mitad del preámbulo."
    },
    {
      "id": "not-only",
      "regex": "(?i)\\bnot only\\b[^.!?\\n]{2,80}\\bbut also\\b",
      "name": "«Not only X but also Y» (inglés)",
      "fix": "Divídelo en dos oraciones, o quita la mitad más débil."
    },
    {
      "id": "isnt-about",
      "regex": "(?i)\\b(?:this|it) is(?:n'?t| not) about [^.!?\\n]{2,60}[.!] it'?s about\\b",
      "name": "«It isn't about X. It's about Y.» (inglés)",
      "fix": "Empieza con Y. La vuelta es lo que te delata."
    },
    {
      "id": "the-result",
      "regex": "(?i)^\\s*(?:the result|the best part|the kicker|the catch)\\?\\s*$",
      "name": "Línea de pregunta retórica de una palabra (inglés)",
      "fix": "Contéstala en la misma línea en vez de montar una revelación."
    },
    {
      "id": "heres-what",
      "regex": "(?i)\\bhere'?s what (?:i|we) learned\\b",
      "name": "«Here's what I learned» (inglés)",
      "fix": "Di la lección. Sáltate el anuncio."
    },
    {
      "id": "triad",
      "regex": "(?i)\\b\\w+, \\w+, and \\w+\\.",
      "name": "Tríada de tres (inglés)",
      "fix": "Dos elementos o cuatro. Tres es el ritmo por defecto del modelo."
    },
    {
      "id": "rocket",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
